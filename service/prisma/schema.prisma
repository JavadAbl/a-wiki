// =============================================================================
// WIKI LEARNING SERVICE
// =============================================================================

model Category {
  id          Int      @id() @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String
  description String?
  icon        String?  @db.NVarChar(MAX)
  order       Int      @default(0)
  courses     Course[]

  @@unique([tenantId, name])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Related links ("لینک‌های مرتبط") managed by admins, shown in the navbar modal
model Link {
  id          Int     @id() @default(autoincrement())
  tenantId    Int
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title       String?
  url         String
  description String?
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id                 Int       @id() @default(autoincrement())
  tenantId           Int
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId         Int?
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  thumbnailUrl       String?
  isPublished        Boolean   @default(false)
  order              Int       @default(0)
  lecturer           String?
  lecturerProfession String?
  favorite           FavoriteCourse?

  relatedCourses    CourseRelatedCourse[] @relation("courseRelatedCourses")
  relatedToCourses  CourseRelatedCourse[] @relation("relatedToCourses")

  sections  Section[]
  documents Document[]

  @@unique([tenantId, title])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Join table: related courses ("دوره‌های مرتبط") set by admins, shown on the course page
model CourseRelatedCourse {
  tenantId        Int
  courseId        Int
  relatedCourseId Int
  course          Course @relation("courseRelatedCourses", fields: [courseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  relatedCourse   Course @relation("relatedToCourses", fields: [relatedCourseId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([courseId, relatedCourseId])
}

/// Courses marked as popular ("دوره‌های پرطرفدار") by admins, shown on the home page
model FavoriteCourse {
  id       Int    @id() @default(autoincrement())
  tenantId Int
  courseId Int    @unique()
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id          Int     @id() @default(autoincrement())
  tenantId    Int
  courseId    Int
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  fileUrl     String
  fileSize    Int
  title       String
  description String?
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Section {
  id          Int     @id() @default(autoincrement())
  tenantId    Int
  courseId    Int
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  order       Int     @default(0)
  description String?

  parts Part[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Part {
  id          Int     @id() @default(autoincrement())
  tenantId    Int
  sectionId   Int
  section     Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  order       Int     @default(0)
  description String?

  contents Content[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  userPartViews PartView[]
}

model Content {
  id              Int     @id() @default(autoincrement())
  tenantId        Int
  partId          Int
  part            Part    @relation(fields: [partId], references: [id], onDelete: Cascade)
  mediaType       String
  mediaUrl        String
  durationSeconds Int     @default(0)
  order           Int     @default(0)
  title           String
  description     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Granular progress tied to a specific course part
model PartView {
  id       Int  @id() @default(autoincrement())
  tenantId Int
  partId   Int
  userId   Int
  part     Part @relation(fields: [partId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, partId])

  createdAt DateTime @default(now())
}
