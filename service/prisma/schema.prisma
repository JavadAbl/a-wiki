// =============================================================================
// WIKI LEARNING SERVICE
// =============================================================================

model Category {
  id          Int      @id() @default(autoincrement())
  name        String   @unique()
  description String?
  icon        String?  @db.NVarChar(MAX)
  courses     Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Related links ("لینک‌های مرتبط") managed by admins, shown in the navbar modal
model Link {
  id          Int      @id() @default(autoincrement())
  title       String?
  url         String
  description String?
  order       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id                 Int       @id() @default(autoincrement())
  categoryId         Int?
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title              String    @unique()
  description        String?
  thumbnailUrl       String?
  isPublished        Boolean   @default(false)
  lecturer           String?
  lecturerProfession String?
  favorite           FavoriteCourse?

  relatedCourses    CourseRelatedCourse[] @relation("courseRelatedCourses")
  relatedToCourses  CourseRelatedCourse[] @relation("relatedToCourses")

  sections  Section[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Join table: related courses ("دوره‌های مرتبط") set by admins, shown on the course page
model CourseRelatedCourse {
  courseId        Int
  relatedCourseId Int
  course          Course @relation("courseRelatedCourses", fields: [courseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  relatedCourse   Course @relation("relatedToCourses", fields: [relatedCourseId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([courseId, relatedCourseId])
}

/// Courses marked as popular ("دوره‌های پرطرفدار") by admins, shown on the home page
model FavoriteCourse {
  id       Int    @id() @default(autoincrement())
  courseId Int    @unique()
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id          Int     @id() @default(autoincrement())
  courseId    Int
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  fileUrl     String
  fileSize    Int
  title       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Section {
  id          Int     @id() @default(autoincrement())
  courseId    Int
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  order       Int     @default(0)
  description String?

  parts Part[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Part {
  id          Int     @id() @default(autoincrement())
  sectionId   Int
  section     Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  order       Int     @default(0)
  description String?

  contents Content[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  userPartViews PartView[]
}

model Content {
  id              Int     @id() @default(autoincrement())
  partId          Int
  part            Part    @relation(fields: [partId], references: [id], onDelete: Cascade)
  mediaType       String
  mediaUrl        String
  durationSeconds Int     @default(0)
  order           Int     @default(0)
  title           String
  description     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Granular progress tied to a specific course part
model PartView {
  id     Int  @id() @default(autoincrement())
  partId Int
  userId Int
  part   Part @relation(fields: [partId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, partId])
}
