// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlserver"
}

// =============================================================================
// TENANCY
// =============================================================================

/// A tenant is one independent "instance" of the wiki (its own users, courses,
/// categories, links and progress). End users pick a tenant on the landing
/// screen; afterwards every request is scoped to that tenant.
model Tenant {
  id          Int     @id() @default(autoincrement())
  name        String
  slug        String  @unique()
  description String?
  logoUrl     String?
  isActive    Boolean @default(true)
  order       Int     @default(0)

  users       User[]
  categories  Category[]
  courses     Course[]
  links       Link[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// AUTH & USER MANAGEMENT 
// =============================================================================

/// tenantId == null means the user is global (only the seeded SuperAdmin).
model User {
  id           Int      @id() @default(autoincrement())
  tenantId     Int?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mobile       String?
  nationalCode String
  firstName    String
  lastName     String
  password     String
  isActive     Boolean  @default(true)
  role         String   @default("User")

  userPermissions UserPermission[]
  userPartViews   PartView[]

  @@unique([tenantId, nationalCode])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id   Int    @id() @default(autoincrement())
  name String @unique()
  type String

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model UserPermission {
  id           Int        @id() @default(autoincrement())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  @@unique([userId, permissionId])
}

model RolePermission {
  id             Int        @id() @default(autoincrement())
  role           String
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId   Int
  permissionName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  @@unique([role, permissionId])
}

